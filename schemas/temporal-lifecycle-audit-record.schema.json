{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/temporal-lifecycle-audit-record.schema.json",
  "title": "Temporal Lifecycle Audit Record",
  "description": "A unified audit record for temporal state evolution, trace packaging, causal integrity, Origin cross-reference, and attribution readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "temporal_lifecycle_audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.5.0"
    },
    "temporal_lifecycle_audit": {
      "$ref": "#/$defs/temporalLifecycleAudit"
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "auditStatus": {
      "type": "string",
      "enum": [
        "pass",
        "pass_with_warnings",
        "disputed",
        "quarantine",
        "fail",
        "human_review_required"
      ]
    },
    "traceStatus": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "disputed",
        "quarantined",
        "superseded"
      ]
    },
    "readinessStatus": {
      "type": "string",
      "enum": [
        "not_ready",
        "candidate",
        "supported",
        "verified",
        "disputed",
        "blocked"
      ]
    },
    "temporalLifecycleAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_id",
        "agent_id",
        "lifecycle_id",
        "created_at",
        "trace_package",
        "audit_scope",
        "audit_result",
        "findings",
        "attribution_readiness",
        "trace_refs"
      ],
      "properties": {
        "audit_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "trace_package": {
          "$ref": "#/$defs/tracePackage"
        },
        "audit_scope": {
          "$ref": "#/$defs/auditScope"
        },
        "audit_result": {
          "$ref": "#/$defs/auditResult"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "origin_cross_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/originCrossReference"
          }
        },
        "disputes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/disputeSummary"
          }
        },
        "temporal_illusion_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/temporalIllusionFinding"
          }
        },
        "attribution_readiness": {
          "$ref": "#/$defs/attributionReadiness"
        },
        "royalty_bridge_status": {
          "$ref": "#/$defs/royaltyBridgeStatus"
        },
        "trace_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "tracePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "lifecycle_id",
        "temporal_range",
        "pulse_refs",
        "state_refs",
        "transition_refs",
        "cadence_decision_refs",
        "causality_record_refs",
        "causal_path_refs",
        "integrity_manifest_ref",
        "trace_status"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_id": {
          "type": "string",
          "minLength": 1
        },
        "temporal_range": {
          "$ref": "#/$defs/temporalRange"
        },
        "pulse_refs": {
          "$ref": "#/$defs/referenceArray"
        },
        "state_refs": {
          "$ref": "#/$defs/referenceArray"
        },
        "transition_refs": {
          "$ref": "#/$defs/referenceArray"
        },
        "cadence_decision_refs": {
          "$ref": "#/$defs/referenceArray"
        },
        "causality_record_refs": {
          "$ref": "#/$defs/referenceArray"
        },
        "causal_path_refs": {
          "$ref": "#/$defs/referenceArray"
        },
        "integrity_manifest_ref": {
          "$ref": "#/$defs/reference"
        },
        "trace_status": {
          "$ref": "#/$defs/traceStatus"
        },
        "omitted_interval_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "temporalRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "ended_at"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "referenceArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "auditScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed_domains"
      ],
      "properties": {
        "executed_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "temporal_continuity",
              "state_lineage",
              "cadence_integrity",
              "precedence_consistency",
              "causality_integrity",
              "temporal_illusion",
              "dispute_visibility",
              "origin_binding",
              "attribution_readiness"
            ]
          }
        },
        "excluded_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope_note": {
          "type": "string"
        }
      }
    },
    "auditResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completed_at",
        "check_run_refs"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/auditStatus"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "check_run_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "summary": {
          "type": "string"
        },
        "human_review_ref": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "domain",
        "severity",
        "finding_code",
        "description",
        "affected_refs",
        "detected_at",
        "status"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "enum": [
            "temporal_continuity",
            "state_lineage",
            "cadence_integrity",
            "precedence_consistency",
            "causality_integrity",
            "temporal_illusion",
            "dispute_visibility",
            "origin_binding",
            "attribution_readiness"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ]
        },
        "finding_code": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "affected_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "detected_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "acknowledged",
            "under_review",
            "mitigated",
            "resolved",
            "rejected"
          ]
        },
        "mitigation_ref": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "originCrossReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_reference_id",
        "origin_ref",
        "temporal_entity_ref",
        "relation_type",
        "assertion_mode",
        "evidence_refs",
        "asserted_at"
      ],
      "properties": {
        "cross_reference_id": {
          "type": "string",
          "minLength": 1
        },
        "origin_ref": {
          "$ref": "#/$defs/reference"
        },
        "temporal_entity_ref": {
          "$ref": "#/$defs/reference"
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "originated_from",
            "derived_from",
            "enabled_by_origin",
            "transformed_from",
            "inspired_by",
            "disputed_origin_relation"
          ]
        },
        "assertion_mode": {
          "type": "string",
          "enum": [
            "runtime_known",
            "runtime_used",
            "retrospective_inference",
            "human_verified",
            "machine_verified",
            "disputed"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "asserted_at": {
          "type": "string",
          "format": "date-time"
        },
        "causal_effective_time": {
          "type": "string",
          "format": "date-time"
        },
        "discovered_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "disputeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispute_ref",
        "status",
        "materiality"
      ],
      "properties": {
        "dispute_ref": {
          "$ref": "#/$defs/reference"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "under_review",
            "partially_resolved",
            "resolved",
            "rejected"
          ]
        },
        "materiality": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ]
        }
      }
    },
    "temporalIllusionFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_ref",
        "rule_id",
        "severity",
        "status"
      ],
      "properties": {
        "finding_ref": {
          "$ref": "#/$defs/reference"
        },
        "rule_id": {
          "type": "string",
          "enum": [
            "TID_001_late_evidence_injection",
            "TID_002_reconstructed_context_substitution",
            "TID_003_post_hoc_narrative",
            "TID_004_timestamp_causality",
            "TID_005_future_knowledge_backflow",
            "TID_006_superseded_decision_confusion"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "error",
            "critical"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "under_review",
            "mitigated",
            "resolved"
          ]
        }
      }
    },
    "attributionReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "assessed_at",
        "supported_causal_path_refs",
        "blocking_finding_refs"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/readinessStatus"
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "supported_causal_path_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "blocking_finding_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "assessment_reason": {
          "type": "string"
        }
      }
    },
    "royaltyBridgeStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_requested",
            "not_ready",
            "candidate_export",
            "ready_for_review",
            "blocked",
            "exported"
          ]
        },
        "royalty_audit_ref": {
          "$ref": "#/$defs/reference"
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
