{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/state-transition-record.schema.json",
  "title": "Temporal State Evolution State Transition Record",
  "description": "A record describing a proposed, evaluated, authorized, and executed state transition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_record"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "transition_record": {
      "$ref": "#/$defs/transitionRecord"
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "transitionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "proposal",
        "source_state",
        "precondition_checks",
        "guard_evaluation",
        "authorization",
        "result",
        "lineage",
        "precedence_claims",
        "trace_refs"
      ],
      "properties": {
        "transition_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal": {
          "$ref": "#/$defs/proposal"
        },
        "source_state": {
          "$ref": "#/$defs/sourceState"
        },
        "precondition_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/preconditionCheck"
          }
        },
        "guard_evaluation": {
          "$ref": "#/$defs/guardEvaluation"
        },
        "authorization": {
          "$ref": "#/$defs/authorization"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        },
        "precedence_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/precedenceClaim"
          }
        },
        "trace_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "requested_transition_type",
        "requested_at",
        "reason"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_transition_type": {
          "$ref": "#/$defs/transitionType"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "pulse_ref": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "transitionType": {
      "type": "string",
      "enum": [
        "retain",
        "advance",
        "branch",
        "suspend",
        "resume",
        "supersede",
        "reconcile",
        "terminate"
      ]
    },
    "sourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_ref",
        "state_version",
        "lineage_id",
        "lifecycle_status"
      ],
      "properties": {
        "state_ref": {
          "$ref": "#/$defs/reference"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_status": {
          "$ref": "#/$defs/lifecycleStatus"
        }
      }
    },
    "lifecycleStatus": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "retained",
        "branched",
        "suspended",
        "superseded",
        "reconciled",
        "terminated",
        "quarantined"
      ]
    },
    "preconditionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "category",
        "result"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "temporal",
            "structural",
            "evidential",
            "authorization",
            "resource",
            "safety"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unresolved"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "description": {
          "type": "string"
        }
      }
    },
    "guardEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "evaluated_guards"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "defer",
            "human_review_required"
          ]
        },
        "evaluated_guards": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "source_state_guard",
              "evidence_guard",
              "precedence_guard",
              "human_gate_guard",
              "lineage_guard"
            ]
          }
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "authority_type",
        "decision",
        "decided_at",
        "rule_refs"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "authority_type": {
          "type": "string",
          "enum": [
            "agent_policy",
            "orchestration_policy",
            "safety_governor",
            "human_reviewer",
            "multi_wing_consensus",
            "system_recovery_policy"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "authorized",
            "rejected",
            "deferred",
            "conditionally_authorized",
            "human_review_required"
          ]
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "rule_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_status",
        "resulting_lifecycle_status"
      ],
      "properties": {
        "execution_status": {
          "type": "string",
          "enum": [
            "executed",
            "rejected",
            "deferred",
            "quarantined"
          ]
        },
        "successor_state_ref": {
          "$ref": "#/$defs/reference"
        },
        "resulting_lifecycle_status": {
          "$ref": "#/$defs/lifecycleStatus"
        },
        "executed_at": {
          "type": "string",
          "format": "date-time"
        },
        "result_reason": {
          "type": "string"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id",
        "root_state_ref",
        "predecessor_refs"
      ],
      "properties": {
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "root_state_ref": {
          "$ref": "#/$defs/reference"
        },
        "predecessor_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "source_branch_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "reconciliation_policy_ref": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "precedenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "precedence_level",
        "predecessor_ref",
        "successor_ref",
        "relation_type",
        "assertion_mode",
        "evidence_refs",
        "confidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "precedence_level": {
          "type": "string",
          "enum": [
            "local",
            "structural",
            "ontological"
          ]
        },
        "predecessor_ref": {
          "$ref": "#/$defs/reference"
        },
        "successor_ref": {
          "$ref": "#/$defs/reference"
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "triggers",
            "transitions_to",
            "causes",
            "evaluated_before",
            "activates",
            "requires",
            "enables",
            "constrains",
            "authorizes",
            "prohibits",
            "routes",
            "conditions",
            "inherits_from",
            "originates_from",
            "derives_from",
            "constituted_by",
            "made_possible_by"
          ]
        },
        "assertion_mode": {
          "type": "string",
          "enum": [
            "runtime_observed",
            "policy_declared",
            "retrospective_inference",
            "human_verified",
            "machine_verified"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
